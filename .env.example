# 复制为 .env 后再填写。
# Prisma CLI 只读取 .env，不读取 .env.local；Next.js 也会加载 .env。

# Better Auth（至少 32 位）
# 生成：pnpm dlx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Neon PostgreSQL Direct 连接串（主机名不含 -pooler）
# Console -> Connection Details -> Direct connection
# 例: postgresql://USER:PASS@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
